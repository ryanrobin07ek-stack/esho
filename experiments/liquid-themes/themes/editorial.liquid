<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ store.name | escape }}</title>
    <style>
      body { margin: 0; background: #f6f1e9; color: #24211d; font: 16px Georgia, serif; }
      main { max-width: 1080px; margin: auto; padding: 48px 24px; }
      h1 { font-size: clamp(2.5rem, 8vw, 5rem); font-weight: 400; }
      .categories, .products { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 20px; }
      .product { background: #fffdf9; padding: 14px; }
      .product img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
    </style>
  </head>
  <body>
    <main>
      <h1>{{ store.name | escape }}</h1>
      <section class="categories" aria-label="Categories">
        {% for category in categories %}
          <article>{{ category.name | escape }}</article>
        {% endfor %}
      </section>
      <section class="products" aria-label="Products">
        {% for product in products %}
          <article class="product">
            {% if product.image %}<img src="{{ product.image | escape }}" alt="{{ product.name | escape }}">{% endif %}
            <h2>{{ product.name | escape }}</h2>
            <p>{{ product.price }}</p>
          </article>
        {% endfor %}
      </section>
    </main>
  </body>
</html>
