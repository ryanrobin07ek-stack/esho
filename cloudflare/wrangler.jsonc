{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eshop-storefront",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFPA2kxSnlxxwR-D",
    "EMAIL_FROM": "Craft <noreply@rrobin.co.ke>",
    "VAPID_SUBJECT": "mailto:admin@rrobin.co.ke",
    "AI_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "CLOUDFLARE_ZONE_ID": "0e232819da4cddeadedcbce934374742",
    "CUSTOM_HOSTNAME_TARGET": "customers.rrobin.co.ke"
  },
  "routes": [
    { "pattern": "rrobin.co.ke/*", "zone_name": "rrobin.co.ke" },
    { "pattern": "*.rrobin.co.ke/*", "zone_name": "rrobin.co.ke" }
  ],
  "assets": {
    "directory": "../www",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/sitemap-main.xml", "/shops", "/shops/", "/api/*", "/media/*", "/themes/*", "/theme-skeletons/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eshop-catalog",
      "database_id": "adc00ef6-d93e-4f6a-b685-933479ef9334",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TENANTS",
      "id": "2a96ffc4dd7d42788c567e237f2a3ff6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUSINESS_ARCHIVE",
      "bucket_name": "eshop-business-archive"
    }
  ]
}
