// Wrangler config for the SECOND deployment of this Worker: the craft.ke Cloudflare account.
//
// Every value that starts with REPLACE_WITH_ comes from the NEW account (zone id, D1 id, KV id, Turnstile site
// key) and must be filled in by hand after those resources are created there. Nothing in this file has been
// deployed: no Worker, database, bucket or namespace exists yet. No id or secret from the existing
// production account is copied here, and secrets are never stored in this file; see CRAFTKE-SECRETS.md.
//
// Same code as production (worker.js); the DOMAIN_ROOT variable below is what makes it serve craft.ke.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craftke-storefront",
  "main": "worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "DOMAIN_ROOT": "craft.ke",
    // craft.ke itself hosts the official Craft website, so the Craft app (main store, sign-in, API) lives here.
    "MAIN_HOST": "app.craft.ke",
    // Names the official Craft website and the safiri site already use under craft.ke. They are never shop names and
    // their traffic is handed straight on (the official site has its own, more specific routes).
    "RESERVED_SUBDOMAINS": "www,pos,crafty,craf,webbuilding,webbuilderinkenya,webbuildercraftke,craftwebandposbuilder,safiri",
    // Public Turnstile widget key (public by design). The widget lives in the new account and allows craft.ke.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGM-m_xyH0uuCDUn",
    "EMAIL_FROM": "Craft <noreply@craft.ke>",
    // Paystack markets switched on. Kenya only until Paystack accounts exist for Nigeria and South Africa (docs/expansion-nigeria-south-africa.md).
    "PAYSTACK_CURRENCIES": "KES",
    "VAPID_SUBJECT": "mailto:admin@craft.ke",
    "AI_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "CLOUDFLARE_ZONE_ID": "646a2db58693a18ea4fca4272f23a4ca",
    "CUSTOM_HOSTNAME_TARGET": "customers.craft.ke"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  // craft.ke itself belongs to the official Craft website (its own Worker and routes), so this Worker only takes
  // the subdomains: app.craft.ke (the Craft app) and every shop at <id>.craft.ke.
  "routes": [
    { "pattern": "*.craft.ke/*", "zone_name": "craft.ke" }
  ],
  "assets": {
    "directory": "../www",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/sitemap-main.xml", "/manifest.webmanifest", "/shops", "/shops/", "/api/*", "/media/*", "/themes/*", "/theme-skeletons/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "craftke-catalog",
      "database_id": "fd15021f-0363-45f9-b936-f3cf34809843",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TENANTS",
      "id": "7999a2de4c614f2ebb1d6c35f16bf90c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUSINESS_ARCHIVE",
      "bucket_name": "craftke-business-archive"
    }
  ]
}
