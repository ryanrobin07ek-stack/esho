{
  "name": "eshop-capacitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "sync:storefront-engine": "node scripts/sync-storefront-engine.mjs",
    "lint:inline": "node scripts/lint-inline-script.mjs",
    "test:pos": "node --test tests/pos.integration.test.mjs",
    "test:cloudflare": "node --test tests/cloudflare.worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "cf:dev": "npm run build && wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:d1:migrate:local": "wrangler d1 migrations apply eshop-catalog --local --config cloudflare/wrangler.jsonc",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply eshop-catalog --remote --config cloudflare/wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.4",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "jeep-sqlite": "^2.7.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "eslint": "^8.57.1",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.1",
    "vite": "^7.0.0",
    "wrangler": "^4.147.0"
  }
}
