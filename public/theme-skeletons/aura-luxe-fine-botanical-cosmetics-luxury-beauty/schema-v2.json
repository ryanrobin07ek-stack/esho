{
  "version": 2,
  "themeId": "aura-luxe-fine-botanical-cosmetics-luxury-beauty",
  "classification": "B",
  "tokens": {
    "colors": {
      "--theme-aura-color-01": "#faf8f5",
      "--theme-aura-color-02": "#f5efeb",
      "--theme-aura-color-03": "#eae3d6",
      "--theme-aura-color-04": "#d8eb58",
      "--theme-aura-color-05": "#141210",
      "--theme-aura-color-06": "#6b6358",
      "--theme-aura-color-07": "#d5cbbf",
      "--theme-aura-color-08": "#b3a595",
      "--theme-aura-color-09": "#efe7de",
      "--theme-aura-color-10": "rgba(255,255,255,0.85)",
      "--theme-aura-color-11": "rgba(20,18,16,0.78)"
    },
    "fonts": {
      "body": "Playfair Display",
      "display": "Plus Jakarta Sans"
    }
  },
  "dataBindings": {
    "APP_CONFIG": "auraAppConfig",
    "CATALOGUE": "auraCatalogue",
    "CATEGORIES": "auraCategories",
    "BRANDS_LIST": "auraBrands"
  },
  "repeaters": [],
  "singleSlots": {
    ".brand-logo": "store.name",
    ".brand-wordmark": "store.name"
  },
  "stripRules": {
    "removeImageSources": true,
    "replaceVisibleTextWithSkeletonBars": true,
    "removeDemoJsonLd": true,
    "replaceKnownJavascriptData": [
      "APP_CONFIG",
      "CATALOGUE",
      "CATEGORIES",
      "BRANDS_LIST"
    ]
  },
  "emptyState": {
    "editor": "show-demo-style-bars-and-palette-gradient-media",
    "live": "hide-empty-repeaters-and-empty-optional-slots"
  },
  "jsonLd": true
}
