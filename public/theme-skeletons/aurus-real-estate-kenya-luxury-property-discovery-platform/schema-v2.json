{
  "version": 2,
  "themeId": "aurus-real-estate-kenya-luxury-property-discovery-platform",
  "classification": "rollout",
  "tokens": {
    "colors": {
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-01": "#0b132b",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-02": "#e05a2b",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-03": "#f8f9fa",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-04": "#1e293b",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-05": "#ffffff",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-06": "rgb(000/0.1)",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-07": "#d1d5db",
      "--theme-aurus-real-estate-kenya-luxury-property-discovery-platform-color-08": "#f3f4f6"
    },
    "fonts": {
      "families": [
        "Plus Jakarta Sans",
        "Syne"
      ]
    }
  },
  "dataBindings": {},
  "scrubbedJavascriptConstants": [
    "STATE",
    "PROPERTIES_DATA",
    "AGENTS_DATA",
    "NEIGHBOURHOODS_DATA"
  ],
  "repeaters": [],
  "singleSlots": {},
  "stripRules": {
    "removeImageSources": true,
    "replaceVisibleTextWithSkeletonBars": true,
    "removeDemoJsonLd": true,
    "scrubUppercaseJavascriptData": [
      "STATE",
      "PROPERTIES_DATA",
      "AGENTS_DATA",
      "NEIGHBOURHOODS_DATA"
    ],
    "parseFailures": []
  },
  "emptyState": {
    "editor": "show-demo-style-bars-and-palette-gradient-media",
    "live": "theme-specific-shop-data-mapping-required"
  },
  "conversionWarning": "Skeleton conversion only; theme-native product/category fill mapping requires separate verification."
}
